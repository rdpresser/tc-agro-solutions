# =====================================================
# TC Agro AppHost Aspire - External Infrastructure Example
# =====================================================
# Copy to .env and adjust values to your Proxmox environment.

InfraSettings__UseExternalResources=true

# Connection strings used by AppHost external validation
ConnectionStrings__redis=192.168.0.220:6379,password=devuser,ssl=false
ConnectionStrings__rabbitmq=amqp://devuser:devuser@192.168.0.230:5672/%2F
ConnectionStrings__postgres=Host=192.168.0.210;Port=5432;Database=postgres;Username=devuser;Password=devuser;Include Error Detail=false

# Section values used to inject environment into services
Cache__Redis__Host=192.168.0.220
Cache__Redis__Port=6379
Cache__Redis__Password=devuser
Cache__Redis__Secure=false
Cache__Redis__InstanceName=tc-agro

Messaging__RabbitMQ__Host=192.168.0.230
Messaging__RabbitMQ__Port=5672
Messaging__RabbitMQ__ManagementPort=15672
Messaging__RabbitMQ__VirtualHost=/
Messaging__RabbitMQ__UserName=devuser
Messaging__RabbitMQ__Password=devuser
Messaging__RabbitMQ__AutoProvision=true
Messaging__RabbitMQ__Durable=true
Messaging__RabbitMQ__UseQuorumQueues=false
Messaging__RabbitMQ__AutoPurgeOnStartup=false

Database__Postgres__Host=192.168.0.210
Database__Postgres__Port=5432
Database__Postgres__UserName=devuser
Database__Postgres__Password=devuser
Database__Postgres__Schema=public
Database__Postgres__MaintenanceDatabase=postgres
Database__Postgres__ConnectionTimeout=30
Database__Postgres__MinPoolSize=2
Database__Postgres__MaxPoolSize=20
Database__Postgres__IncludeErrorDetail=false
Database__Postgres__SslMode=Disable
Database__Postgres__TrustServerCertificate=true

OpenAI__Enabled=true
OpenAI__BaseUrl=https://api.openai.com/
OpenAI__Model=gpt-4o-mini
OpenAI__Temperature=0.3
OpenAI__MaxSuggestions=15
OpenAI__TimeoutSeconds=60
OpenAI__ApiKey=your-openai-api-key-placeholder

WeatherProvider__BaseUrl=https://api.open-meteo.com
WeatherProvider__Latitude=-22.7256
WeatherProvider__Longitude=-47.6492
WeatherProvider__MaxCoordinatesPerRequest=50

Jobs__SensorReadings__Enabled=true
Jobs__SensorReadings__IntervalSeconds=15

Alerts__Thresholds__MaxTemperature=35
Alerts__Thresholds__MinSoilMoisture=30
Alerts__Thresholds__MinBatteryLevel=20

Networking__ForwardedHeaders__Enabled=true
Networking__ForwardedHeaders__KnownProxies__0=10.0.0.1

Telemetry__Grafana__Agent__Host=192.168.0.30
Telemetry__Grafana__Agent__OtlpGrpcPort=4317
Telemetry__Grafana__Agent__OtlpHttpPort=4318
Telemetry__Grafana__Agent__MetricsPort=12345
Telemetry__Grafana__Agent__Enabled=true
Telemetry__Grafana__Otlp__Endpoint=http://192.168.0.30:4318
Telemetry__Grafana__Otlp__Protocol=http/protobuf
Telemetry__Grafana__Otlp__TimeoutSeconds=10
Telemetry__Grafana__Otlp__Insecure=true

Auth__Jwt__Issuer=tc-agro-identity-service
Auth__Jwt__Audience__0=tc-agro-identity-service
Auth__Jwt__Audience__1=tc-agro-farm-service
Auth__Jwt__Audience__2=tc-agro-sensor-ingest-service
Auth__Jwt__Audience__3=tc-agro-analytics-worker
Auth__Jwt__Audience__4=tc-agro-dashboard-service
Auth__Jwt__SecretKey=your-256-bit-secret-key-change-in-production-12345678901234567890
Auth__Jwt__ExpirationInMinutes=480

Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft_AspNetCore=Warning
Logging__LogLevel__System=Warning
