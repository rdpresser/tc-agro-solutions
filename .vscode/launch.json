{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET: Identity Service (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-identity-service",
      "program": "${workspaceFolder}/services/identity-service/src/Adapters/Inbound/TC.Agro.Identity.Service/bin/Debug/net10.0/TC.Agro.Identity.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/identity-service/src/Adapters/Inbound/TC.Agro.Identity.Service",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5001"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": ".NET: Farm Service (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-farm-service",
      "program": "${workspaceFolder}/services/farm-service/src/Adapters/Inbound/TC.Agro.Farm.Service/bin/Debug/net10.0/TC.Agro.Farm.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/farm-service/src/Adapters/Inbound/TC.Agro.Farm.Service",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5002"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": ".NET: Sensor Ingest Service (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-sensor-ingest-service",
      "program": "${workspaceFolder}/services/sensor-ingest-service/src/Adapters/Inbound/TC.Agro.SensorIngest.Service/bin/Debug/net10.0/TC.Agro.SensorIngest.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/sensor-ingest-service/src/Adapters/Inbound/TC.Agro.SensorIngest.Service",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5003"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": ".NET: Analytics Worker (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-analytics-worker-service",
      "program": "${workspaceFolder}/services/analytics-worker/src/Adapters/Inbound/TC.Agro.Analytics.Service/bin/Debug/net10.0/TC.Agro.Analytics.Service.dll",
      "args": [],
      "cwd": "${workspaceFolder}/services/analytics-worker/src/Adapters/Inbound/TC.Agro.Analytics.Service",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5004"
      },
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "K8s: Infra Only (Run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "prepare-k8s-infra-only",
      "program": "dotnet",
      "args": [
        "--info"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Docker Compose: VS2026 Debug (Run)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-compose-infra-and-services-up-with-vs-debug",
      "program": "dotnet",
      "args": [
        "--info"
      ],
      "cwd": "${workspaceFolder}/orchestration/apphost-compose",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "K8s Infra Only",
      "configurations": [
        "K8s: Infra Only (Run)"
      ],
      "stopAll": true
    },
    {
      "name": "Docker Compose VS2026 Debug",
      "configurations": [
        "Docker Compose: VS2026 Debug (Run)"
      ],
      "stopAll": true
    },
    {
      "name": "Full Stack Services (Debug)",
      "configurations": [
        ".NET: Identity Service (Debug)",
        ".NET: Farm Service (Debug)",
        ".NET: Sensor Ingest Service (Debug)",
        ".NET: Analytics Worker (Debug)"
      ],
      "stopAll": true
    }
  ]
}
