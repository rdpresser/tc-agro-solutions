meta {
  name: PUT UpdateUser
  type: http
  seq: 3
}

put {
  url: {{identity_service_url}}/api/user/{{id}}
  body: json
  auth: bearer
}

headers {
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "name": "John Smith",
    "email": "john.smith@gmail.com",
    "username": "johnsmith"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
