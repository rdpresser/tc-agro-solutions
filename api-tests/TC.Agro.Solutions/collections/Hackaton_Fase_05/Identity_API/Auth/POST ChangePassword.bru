meta {
  name: POST ChangePassword
  type: http
  seq: 1
}

post {
  url: {{identity_service_url}}/auth/change-password
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "email": "{{user_email}}",
    "password": "{{new_password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

