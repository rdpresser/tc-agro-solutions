meta {
  name: Login - Producer
  type: http
  seq: 6
}

post {
  url: {{identity_service_url}}/auth/login
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "email": "{{producer_email}}",
    "password": "{{producer_password}}"
  }
}

script:post-response {
  const status = res.getStatus();

  if (status < 200 || status >= 300) {
    console.log("LoginProducer failed with status:", status);
    return;
  }

  const body = res.getBody();
  const token = body?.jwtToken || body?.accessToken || body?.token;

  if (!token || typeof token !== "string") {
    console.log("LoginProducer did not return token");
    return;
  }

  bru.setEnvVar("producer_token", token);
  // Keep compatibility with existing requests that read admin_token as bearer token.
  bru.setEnvVar("admin_token", token);
  if (typeof bru.getEnvVar === "function") {
    const producerEmail = bru.getEnvVar("producer_email");
    if (producerEmail) {
      bru.setEnvVar("user_email", producerEmail);
    }
  }
  console.log("producer_token updated successfully");
}

settings {
  encodeUrl: true
  timeout: 0
}
