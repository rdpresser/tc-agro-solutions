meta {
  name: GET GetCropTypeById
  type: http
  seq: 5
}

get {
  url: {{farm_service_url}}/api/crop-types/{{id}}?includeInactive=false
  body: none
  auth: bearer
}

headers {
  accept: application/json
}

params:query {
  includeInactive: false
}

auth:bearer {
  token: {{admin_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

