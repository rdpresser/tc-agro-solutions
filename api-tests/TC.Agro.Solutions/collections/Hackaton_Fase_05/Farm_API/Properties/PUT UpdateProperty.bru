meta {
  name: PUT UpdateProperty
  type: http
  seq: 4
}

put {
  url: {{farm_service_url}}/api/properties/{{id}}
  body: json
  auth: bearer
}

headers {
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "name": "Fazenda Boa Vista Updated",
    "address": "Estrada Rural Km 20",
    "city": "Ribeirão Preto",
    "state": "SP",
    "country": "Brazil",
    "areaHectares": 300.0,
    "latitude": -21.18,
    "longitude": -47.825
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

