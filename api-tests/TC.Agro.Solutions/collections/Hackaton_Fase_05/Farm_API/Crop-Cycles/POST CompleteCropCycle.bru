meta {
  name: POST CompleteCropCycle
  type: http
  seq: 2
}

post {
  url: {{farm_service_url}}/api/crop-cycles/{{crop_cycle_id}}/complete
  body: json
  auth: bearer
}

headers {
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{admin_token}}
}

body:json {
  {
    "endedAt": "2026-03-12T14:57:37.598998-03:00",
    "finalStatus": "Harvested",
    "notes": "Harvest completed successfully. Yield recorded."
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

