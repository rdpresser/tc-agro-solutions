meta {
  name: 01 Auth Create Producer
  type: http
  seq: 1
}

post {
  url: {{identity_service_url}}/auth/register
  body: json
  auth: none
}

headers {
  accept: application/json
  content-type: application/json
}

body:json {
  {
    "name": "{{producer_name}}",
    "email": "{{producer_email}}",
    "username": "{{producer_username}}",
    "password": "{{producer_password}}",
    "role": "Producer"
  }
}


script:post-response {
  const status = res.getStatus();

  if (status < 200 || status >= 300) {
    console.log("Auth Create Producer failed with status:", status);
    return;
  }

  const body = res.getBody();
  const userId = body?.id || body?.userId || body?.data?.id || body?.value?.id;

  if (typeof userId === "string" && userId.length > 0) {
    bru.setEnvVar("id", userId);
    bru.setEnvVar("owner_id", userId);
    console.log("id and owner_id updated from create producer:", userId);
  }

  if (typeof bru.getEnvVar === "function") {
    const producerEmail = bru.getEnvVar("producer_email");
    if (producerEmail) {
      bru.setEnvVar("user_email", producerEmail);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

