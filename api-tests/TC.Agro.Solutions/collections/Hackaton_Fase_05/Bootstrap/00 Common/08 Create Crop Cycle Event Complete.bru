meta {
  name: 08 Create Crop Cycle Event Complete
  type: http
  seq: 8
}

post {
  url: {{farm_service_url}}/api/crop-cycles/{{crop_cycle_id}}/complete
  body: json
  auth: bearer
}

headers {
  accept: application/json
  content-type: application/json
}

auth:bearer {
  token: {{jwt_token}}
}

body:json {
  {
    "endedAt": "2026-09-30T12:00:00Z",
    "finalStatus": "Harvested",
    "notes": "Bootstrap complete event."
  }
}

script:post-response {
  const status = res.getStatus();

  if (status < 200 || status >= 300) {
    console.log("Crop Cycle Complete failed with status:", status);
    return;
  }

  console.log("Crop cycle complete event processed");
}

settings {
  encodeUrl: true
  timeout: 0
}
