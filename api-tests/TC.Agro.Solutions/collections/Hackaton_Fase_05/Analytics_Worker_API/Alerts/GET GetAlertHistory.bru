meta {
  name: GET GetAlertHistory
  type: http
  seq: 3
}

get {
  url: {{analytics_service_url}}/api/alerts/history/{{sensor_id}}?pageNumber=1&pageSize=20&days=7&alertType=sample&status=Pending
  body: none
  auth: bearer
}

headers {
  accept: application/json
}

params:query {
  pageNumber: 1
  pageSize: 20
  days: 7
  alertType: sample
  status: Pending
}

auth:bearer {
  token: {{admin_token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

